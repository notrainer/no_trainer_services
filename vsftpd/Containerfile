FROM docker.io/library/ubuntu:26.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends vsftpd \
    && rm -rf /var/lib/apt/lists/*

COPY vsftpd.conf /etc/vsftpd.conf

RUN useradd -m -d /home/ftpuser -s /bin/bash ftpuser && echo "ftpuser:password123" | chpasswd \
    && mkdir -p /var/empty/vsftpd /srv/ftp/upload \
    && chmod 0555 /var/empty/vsftpd && chmod 0777 /srv/ftp/upload

EXPOSE 20 21

CMD ["/usr/sbin/vsftpd", "/etc/vsftpd.conf"]


