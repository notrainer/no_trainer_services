FROM docker.io/library/ubuntu:26.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends samba \
    && rm -rf /var/lib/apt/lists/*

COPY smb.conf /etc/samba/smb.conf

RUN useradd -m -s /bin/bash sambauser && printf 'password\npassword\n' | smbpasswd -a -s sambauser \
    && mkdir -p /srv/samba/public && chmod 0777 /srv/samba/public

EXPOSE 137 138 139 445

CMD ["smbd", "--foreground", "--no-process-group"]
